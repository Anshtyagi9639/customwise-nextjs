# Public canonical origin used for metadata, sitemap and structured data (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.customswise.ie

# Where website enquiries are POSTed as JSON (email service, CRM, automation tool or internal API).
# Without it, the form tells visitors online enquiries are not connected yet and shows the phone number and email instead (nothing is sent or stored).
ENQUIRY_WEBHOOK_URL=
# Optional bearer token sent with the webhook request
ENQUIRY_WEBHOOK_SECRET=
# Recipient address included in the webhook payload
CONTACT_EMAIL=info@customswise.ie

# Where newsletter sign-ups are POSTed as JSON ({ type, receivedAt, email, source }), e.g. your mailing-list
# provider or an automation tool. Without it, the sign-up form tells visitors newsletter sign-up isn't open yet
# and nothing is stored.
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=
